# ==============================================================================
# labdatadev-gamehub — variáveis do stack Supabase self-hosted.
#
# NÃO edite os valores aqui — este arquivo é só o molde. O real é
# `deploy/supabase/.env` (gitignored), gerado por `deploy/supabase-up.sh` na
# primeira execução via `gerar-chaves.mjs`. Documentado para quem quiser saber
# o que cada variável faz, ou gerar manualmente fora do fluxo automático.
# ==============================================================================

# --- Gerados por `node deploy/supabase/gerar-chaves.mjs` (não copie a mão) ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
REALTIME_DB_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# --- Preenchidos por deploy/supabase-up.sh a partir do domínio informado ---
# URL pública que o KONG anuncia para si mesmo (GoTrue usa para montar links).
# Em produção: https://api.SEUDOMINIO.com.br — ver docs/deploy/03.
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
# URL do APP (Next.js) — usada por GoTrue para CORS/redirect allow-list.
SITE_URL=http://127.0.0.1:8081

# Porta do Kong no HOST (só 127.0.0.1 — nunca público direto; quem fala com a
# internet é o Nginx da VPS, ver deploy/nginx.conf.template).
KONG_HTTP_PORT=8000
