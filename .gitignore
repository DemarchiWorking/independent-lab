# Dependências
node_modules/
.pnp
.pnp.js

# Next.js
/.next/
/out/
next-env.d.ts

# Produção
/build
*.tsbuildinfo

# Ambiente
.env
.env*.local

# Dados de negócios/usuários reais (nunca versionar)
/data

# Cópias/experimentos do projeto dentro do próprio projeto.
# (têm .git, .env e data/ próprios — nunca devem entrar neste repositório)
/gamehub-independentlab
/*-independentlab

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Worktrees de agente (Claude Code) — scratch de sessão, nunca versiona.
.claude/worktrees/

# Terraform (deploy/terraform/) — estado e segredos nunca versionam.
# `.terraform.lock.hcl` FICA de fora deste ignore de propósito — é o lock
# de versão de provider, deve ser commitado (prática padrão Terraform).
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfvars
deploy/terraform/crash.log
