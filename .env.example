# Driver de persistência: "file" (protótipo, JSON em data/) ou "supabase"
GAMEHUB_DB=file

# Allowlist de admin (Épico 11 — Eventos Globais), e-mails separados por
# vírgula. Sem isso, /admin/eventos fica inacessível para todo mundo.
GAMEHUB_ADMIN_EMAILS=

# Segredo de assinatura do cookie de sessão (mín. 16 chars).
# Obrigatório em produção. Gere com: openssl rand -hex 32
GAMEHUB_SECRET=

# --- Necessário apenas quando GAMEHUB_DB=supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha esta chave ao browser — ela ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=
