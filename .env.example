# Driver de persistência: "file" (JSON em GAMEHUB_DATA_DIR) ou "supabase".
# O modo file exige UMA instância do app (a trava de escrita é por processo).
GAMEHUB_DB=file

# Pasta dos dados no modo file. Em produção aponta para um volume FORA da
# release (o container usa /data). Sem isso, fica em ./data.
GAMEHUB_DATA_DIR=

# Segredo que assina sessão e convite. OBRIGATÓRIO em qualquer modo, mínimo
# 32 caracteres, sem valor padrão. Gere com: openssl rand -hex 32
# (em dev, o `npm run dev` gera um sozinho no .env local)
# Trocar o segredo desconecta todo mundo e invalida todos os convites.
GAMEHUB_SECRET=

# Allowlist de admin (eventos globais), e-mails separados por vírgula,
# comparação exata. Vazio = ninguém acessa /admin/eventos.
GAMEHUB_ADMIN_EMAILS=

# URL pública, com https em produção (sitemap, robots e links absolutos).
# É embutida no bundle em tempo de BUILD: passe também como build-arg do Docker.
NEXT_PUBLIC_SITE_URL=

# Senha do login de demonstração (só para o seed de pitch; 12+ caracteres).
# SEED_DEMO_SENHA=

# --- Necessário apenas quando GAMEHUB_DB=supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha esta chave ao browser — ela ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA dos Funcionários (ver docs/equipe-ia/IA-OPERACAO.md) ---
# A credencial da Anthropic NÃO vai neste arquivo: fica só no worker de IA
# (deploy/ia.env.example -> /opt/independent-lab/.env.ia). O app recusa subir
# em produção se receber ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN ou
# CLAUDE_CODE_OAUTH_TOKEN.
#
# Único e-mail que muda a configuração da IA em /admin/ia. Padrão: admin@admin.com.
# GAMEHUB_IA_ADMIN_EMAIL=
# Pasta de troca com o worker. Padrão: <GAMEHUB_DATA_DIR>/ia.
# GAMEHUB_IA_DIR=
# 0 desliga o agendador interno (coleta e melhoria contínua) neste processo.
# GAMEHUB_IA_AGENDADOR=1
# Em produção o cadastro público recusa e-mail de admin. 1 libera POR UM INSTANTE,
# para você criar a sua conta de admin; remova e reinicie logo depois.
# GAMEHUB_LIBERAR_CADASTRO_ADMIN=
